#!/usr/bin/env bash

# T2.2 (F4): strict mode for the entire engine. Tactical `|| true` is applied
# ONLY to documented cosmetic Hyprland IPC (hyprctl keyword/dispatch) and
# notify-send calls — NEVER on xfreerdp3, flock, jq, file tests, or any
# security-relevant call (per engine-robustness-delta R2 mitigation).
set -euo pipefail

# multi-peer-race (F-G fix part 1): become a session leader so the EXIT trap
# can `kill -- -$$` to reap child processes (xfreerdp3).
#
# CRITICAL: standard `setpgid 0 0` is a bash-builtin on some distros but an
# external util-linux binary on Arch (and possibly others), where it takes
# completely different args ("run a program in a new process group"). The
# previous form `setpgid 0 0 || true` SILENTLY FAILED via `|| true`, leaving
# the engine in its parent's process group — `kill -- -$$` would then kill
# the parent's whole group (e.g. user's interactive shell). Caught by the
# behavioral coverage follow-up to multi-peer-race.
#
# The portable idiom is `exec setsid --wait`: setsid creates a NEW session
# (which is also a new process group) with the calling process as leader,
# and re-execs this script. `--wait` makes setsid propagate the child's
# exit code back. PID is preserved across the re-exec, so `$$` remains the
# engine's PID == PGID == SID.
#
# Guard via env var to avoid infinite re-exec loop.
if [ -z "${_RDP_SESSION_ESTABLISHED:-}" ]; then
    _RDP_SESSION_ESTABLISHED=1 exec setsid --wait "$0" "$@" || exit $?
fi

# --- OPTIONAL FLAGS: -v | --no-audio | --single-mon | --multi-mon [<profile>] ---
# Strip all optional flags from argv in a single pass, BEFORE --help and every
# other arg-consuming block.
#   -v/--verbose  -> VERBOSE=1 (lib log_event tees to stderr)
#   --no-audio    -> NO_AUDIO=1 (force SOUND_FLAGS empty)
#   --single-mon  -> MONITOR_MODE_OVERRIDE=single (force single-monitor fullscreen)
#   --multi-mon    -> MONITOR_MODE_OVERRIDE=multi  (force multi-monitor)
# Note: under Hyprland/XWayland a single xfreerdp3 window cannot span physical
# monitors, so /multimon renders all remote monitors into one cramped window;
# single mode (+f) fullscreens one remote monitor instead. The mode is also
# settable per-profile via MONITOR_MODE (multi [default] | single).
VERBOSE=0
NO_AUDIO=0
MONITOR_MODE_OVERRIDE=""
MONITORS_OVERRIDE=""            # --monitors <n>   (multi: use first N detected)
MONITOR_ORDER_OVERRIDE=""       # --monitor-order <ids>  (multi: explicit id order)
DYNAMIC_RESOLUTION_OVERRIDE=""  # --dynamic-resolution  (single: +dynamic-resolution)
_new_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)         VERBOSE=1; shift ;;
        --no-audio)           NO_AUDIO=1; shift ;;
        --single-mon)         MONITOR_MODE_OVERRIDE=single; shift ;;
        --multi-mon)          MONITOR_MODE_OVERRIDE=multi; shift ;;
        --span)               MONITOR_MODE_OVERRIDE=span; shift ;;
        --dynamic-resolution) DYNAMIC_RESOLUTION_OVERRIDE=1; shift ;;
        --monitors)           MONITORS_OVERRIDE="${2:-}"; shift; shift || true ;;
        --monitor-order)      MONITOR_ORDER_OVERRIDE="${2:-}"; shift; shift || true ;;
        --client)             _client_override="${2:-}"; shift; shift || true ;;
        *)                    _new_args+=("$1"); shift ;;
    esac
done
set -- "${_new_args[@]}"
unset _new_args

# --- COLORS (rich-like) + MODO AYUDA: rdp-connect --help / -h ---
# setup_colors (in lib) populates C_* only when stdout is a TTY and NO_COLOR is
# unset. The lib is fully sourced later (L108); here we source it ONLY if the
# file exists so --help can colorize. `make smoke` runs --help in a throwaway
# HOME without the deployed lib -> we degrade to plain help (C_* empty) and still
# exit 0 (preserves the W-5 fix: --help works without the lib/mkdir setup).
C_TITLE="" C_CMD="" C_FLAG="" C_KEY="" C_DIM="" C_BOLD="" C_R=""
[ -f "$HOME/.local/lib/rdp/rdp-common.bash" ] && source "$HOME/.local/lib/rdp/rdp-common.bash" && setup_colors
if [ "${1:-}" == "--help" ] || [ "${1:-}" == "-h" ]; then
    cat << HELP_EOF
${C_TITLE}rdp-connect${C_R} ${C_DIM}— RDP connection framework for Hyprland/Wayland (xfreerdp3)${C_R}

${C_BOLD}Usage:${C_R}
  ${C_CMD}rdp-connect${C_R}                              ${C_DIM}Open graphical selector (wofi/rofi)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}<profile>${C_R}                        ${C_DIM}Direct connection to a profile${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--new${C_R} ${C_KEY}<name>${C_R}                   ${C_DIM}Create a new profile from template${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--update-profiles${C_R}                 ${C_DIM}Add monitor-layout keys to existing profiles${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--log${C_R} ${C_KEY}<profile>${C_R}                ${C_DIM}Tail the profile's audit log${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}-v${C_R} ${C_KEY}<profile>${C_R}                   ${C_DIM}Verbose: milestones + xfreerdp3 output on stderr${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--no-audio${C_R} ${C_KEY}<profile>${C_R}           ${C_DIM}Disable audio redirect (sound stays on remote)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--single-mon${C_R} ${C_KEY}<profile>${C_R}         ${C_DIM}Single-monitor (DEFAULT): floating, fullscreen on launch, always resizable${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--multi-mon${C_R} ${C_KEY}<profile>${C_R}          ${C_DIM}Multi-monitor (all monitors; cramped under Hyprland)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--span${C_R} ${C_KEY}<profile>${C_R}               ${C_DIM}Unify monitors into ONE floating window (canvas auto-detected)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--expand${C_R} ${C_KEY}<profile>${C_R}             ${C_DIM}Apply the span layout to an ALREADY RUNNING session (bind to a key)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--dynamic-resolution${C_R} ${C_KEY}<profile>${C_R} ${C_DIM}No-op (single mode is always dynamic-resolution now)${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--monitors${C_R} ${C_KEY}<n>${C_R} ${C_KEY}<profile>${C_R}     ${C_DIM}Multi/span/expand: use first <n> detected monitors${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--monitor-order${C_R} ${C_KEY}<ids>${C_R} ${C_KEY}<profile>${C_R}  ${C_DIM}Multi/span/expand: use these monitor IDs in order${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--client${C_R} ${C_KEY}<x11|sdl|wayland>${C_R} ${C_KEY}<profile>${C_R}  ${C_DIM}Choose the FreeRDP client binary${C_R}
  ${C_CMD}rdp-connect${C_R} ${C_FLAG}--help${C_R} | ${C_FLAG}-h${C_R}                  ${C_DIM}Show this help message${C_R}

${C_BOLD}Profiles:${C_R}   ${C_DIM}~/.config/rdp/profiles/*.env${C_R}
${C_BOLD}Monitor keys:${C_R} ${C_KEY}MONITORS${C_R}, ${C_KEY}MONITOR_ORDER${C_R}, ${C_KEY}MONITOR_<id>${C_R}, ${C_KEY}DYNAMIC_RESOLUTION${C_R} ${C_DIM}(run --update-profiles to add them)${C_R}
${C_BOLD}Logs:${C_R}       ${C_DIM}~/.local/state/rdp/<profile>.log${C_R}
${C_BOLD}Lockfile:${C_R}   ${C_DIM}${XDG_RUNTIME_DIR:-/tmp}/rdp-<profile>-<uid>.pid${C_R}
${C_DIM}Set NO_COLOR=1 to disable colors.${C_R}
HELP_EOF
    exit 0
fi

PROFILES_DIR="$HOME/.config/rdp/profiles"
I18N_DIR="$HOME/.config/rdp/i18n"
LOG_DIR="$HOME/.local/state/rdp"
SHARE_DIR="$HOME/Compartido"
LIB_FILE="$HOME/.local/lib/rdp/rdp-common.bash"

mkdir -p "$LOG_DIR" "$SHARE_DIR" "$PROFILES_DIR" "$I18N_DIR"

# --- CARGA DE LA BIBLIOTECA DE FUNCIONES PURAS (F3 parser, F5 PID path, F1 hidpi, F6/F8 helpers) ---
# shellcheck source=/home/hbuddenberg/.local/lib/rdp/rdp-common.bash
source "$LIB_FILE"

# --- PREFLIGHT (F6 + F7): every external binary present + xfreerdp3 build gate ---
# F6: require_cmd exits 127 if a binary is missing. Done BEFORE any profile is
# loaded so a missing dep never reaches a credential-adjacent code path. The
# wofi|rofi launcher OR-check is deferred to selector mode (only needed there).
require_cmd xfreerdp3 freerdp3
require_cmd hyprctl hyprland
require_cmd jq jq
require_cmd notify-send libnotify
require_cmd flock util-linux

# F7: the credential pipe is on the password path. A build without /from-stdin
# support would either leak the password via /p: on the command line or hang
# forever reading stdin. The feature gate MUST fail loudly — NEVER silently
# fall back to /p:.
if ! xfreerdp3 /help 2>&1 | grep -q from-stdin; then
    echo "ERROR: xfreerdp3 build does not support /from-stdin:force." >&2
    echo "       Install a FreeRDP3 build with stdin credential support." >&2
    exit 1
fi

# --- DETECCIÓN Y CARGA DE IDIOMA (i18n) ---
# Cargado a través del parser endurecido (F2: no `source`). El modo `i18n`
# acepta solo claves con prefijo MSG_*; cualquier otra clave (p.ej. PATH=)
# aborta el motor — un archivo i18n hostil es un evento de seguridad, no un
# fallback silencioso.
load_language() {
    local target_lang="${1:-${LANG:-es}}"
    target_lang="${target_lang:0:2}"
    local lang_file="$I18N_DIR/${target_lang}.env"
    [ -f "$lang_file" ] || lang_file="$I18N_DIR/es.env"
    parse_env_safe "$lang_file" i18n || {
        notify-send -u critical "RDP Error" "Diccionario de idioma inválido ($lang_file). Ver consola." 2>/dev/null || true
        exit 1
    }
}
load_language

# --- PARSER SEGURO DE CONFIGURACIÓN (Previene inyección de código Bash) ---
# La implementación vive en lib/rdp-common.bash (sourced arriba como LIB_FILE).
# Permite allowlist estricto (HOST, USER_RDP, PASS_RDP, DOMAIN, VPN_CHECK,
# PREFERRED_WS, LANG_OVERRIDE) y normaliza comillas/comentarios. Cualquier
# clave fuera de la allowlist aborta el motor.

# --- MODO VISOR DE LOGS: rdp-connect --log <perfil> ---
if [ "${1:-}" == "--log" ] || [ "${1:-}" == "-l" ]; then
    LOG_PROFILE="${2:-}"
    [ -z "$LOG_PROFILE" ] && { echo "$MSG_LOG_USAGE"; exit 1; }
    TARGET_LOG="$LOG_DIR/${LOG_PROFILE}.log"
    [ ! -f "$TARGET_LOG" ] && { printf "$MSG_LOG_NO_FILE\n" "$LOG_PROFILE"; exit 1; }
    echo "=== Viendo log en vivo de '$LOG_PROFILE' ($TARGET_LOG) ==="
    tail -n 30 -f "$TARGET_LOG"
    exit 0
fi

# --- MODO EXPANDIR: rdp-connect --expand <perfil> [--monitors N | --monitor-order ids] ---
# Applies the span layout (float + ABSOLUTE resize + move + noborder/noblur/
# noshadow) to an ALREADY RUNNING session's window, live — no new xfreerdp3
# process, no credentials touched. Meant for a Hyprland keybind: a single-mode
# session always has +dynamic-resolution active (see the MONITOR MODE block
# below), so resizing its window renegotiates the RDP canvas live. Multi-mode
# sessions do NOT have dynamic-resolution — expanding one will move/resize the
# window but the RDP content itself won't rescale to fill it.
#
# --monitors/--monitor-order here are the CLI flags ONLY (already parsed into
# MONITORS_OVERRIDE/MONITOR_ORDER_OVERRIDE above) — this is a live action
# against a running window, not a profile launch, so profile config is not
# re-read; pass the flags explicitly if you want a monitor subset.
#
# hl.dsp.window.resize's absolute-size form (relative = false) is the
# LEAST-confirmed dispatcher signature in this engine (no first-party example
# found) — like every hl.dsp.* call here, real compositor execution is
# manual-verify; `|| true` keeps a bad guess from ever breaking the session.
if [ "${1:-}" == "--expand" ]; then
    EXPAND_PROFILE="${2:-}"
    [ -z "$EXPAND_PROFILE" ] && { echo "Uso: rdp-connect --expand <perfil>" >&2; exit 1; }
    EXPAND_CLASS="rdp-${EXPAND_PROFILE}"

    if ! hyprctl clients -j 2>/dev/null | jq -e --arg c "$EXPAND_CLASS" 'any(.[]; .class==$c)' >/dev/null 2>&1; then
        echo "rdp-connect --expand: no hay sesión activa para '$EXPAND_PROFILE' (class=$EXPAND_CLASS)." >&2
        exit 1
    fi

    # sort_by(.x): hyprctl's numeric monitor `id` is assigned by detection/
    # connection order, NOT physical left-to-right position (confirmed on
    # real hardware — see tests/monitor-config.bats). Without this, the
    # default "all detected" id list can put remote-monitor content in the
    # wrong physical slot even though the window itself lands correctly.
    _exp_ids=$(hyprctl monitors -j | jq -r 'sort_by(.x) | .[].id' | paste -sd, -)
    if [ -n "${MONITOR_ORDER_OVERRIDE:-}" ]; then
        _exp_ids="$MONITOR_ORDER_OVERRIDE"
    elif [ -n "${MONITORS_OVERRIDE:-}" ]; then
        _exp_ids=$(printf '%s\n' "$_exp_ids" | tr ',' '\n' | head -n "$MONITORS_OVERRIDE" | paste -sd, -)
    fi
    _exp_json=$(hyprctl monitors -j 2>/dev/null | jq -c --arg ids "$_exp_ids" \
        '($ids | split(",") | map(tonumber)) as $sel
         | [.[] | select(.id as $i | $sel | index($i) != null)]' 2>/dev/null || true)
    _exp_w=$(printf '%s' "${_exp_json:-[]}" | jq '[.[].width] | add // empty' 2>/dev/null || true)
    _exp_h=$(printf '%s' "${_exp_json:-[]}" | jq '[.[].height] | max // empty' 2>/dev/null || true)
    _exp_x=$(printf '%s' "${_exp_json:-[]}" | jq '[.[].x] | min // 0' 2>/dev/null || echo 0)
    _exp_y=$(printf '%s' "${_exp_json:-[]}" | jq '[.[].y] | min // 0' 2>/dev/null || echo 0)
    if [ -z "${_exp_w:-}" ] || [ -z "${_exp_h:-}" ]; then
        echo "rdp-connect --expand: no se pudo calcular el canvas (hyprctl/jq)." >&2
        exit 1
    fi

    hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    hyprctl dispatch "hl.dsp.window.resize({ x = ${_exp_w}, y = ${_exp_h}, relative = false, window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    hyprctl dispatch "hl.dsp.window.move({ x = ${_exp_x}, y = ${_exp_y}, window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noborder\", value = \"true\", window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noblur\", value = \"true\", window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noshadow\", value = \"true\", window = \"class:$EXPAND_CLASS\" })" &>/dev/null || true
    echo "rdp-connect --expand: '$EXPAND_PROFILE' -> ${_exp_w}x${_exp_h} en (${_exp_x},${_exp_y})."
    unset _exp_ids _exp_json _exp_w _exp_h _exp_x _exp_y
    exit 0
fi

# --- MODO ACTUALIZAR PROFILES: rdp-connect --update-profiles ---
# Idempotently append the monitor-layout block (MONITORS / MONITOR_ORDER /
# MONITOR_<id> / DYNAMIC_RESOLUTION, all commented out) to every existing
# profile, so profiles created before this feature learn the new keys as
# documented options. Backs up each modified profile to <name>.env.bak.<ts>;
# skips profiles that already have the block. Never overwrites real values.
# append_tunables_block / profile_has_tunables_block live in lib/rdp-common.bash.
if [ "${1:-}" == "--update-profiles" ]; then
    _updated=0; _skipped=0; _ts="$(date +%s)"
    if [ ! -d "$PROFILES_DIR" ]; then
        printf '%sno profiles dir: %s%s\n' "${C_DIM:-}" "$PROFILES_DIR" "${C_R:-}"
        exit 1
    fi
    for _f in "$PROFILES_DIR"/*.env; do
        [ -f "$_f" ] || continue
        if profile_has_tunables_block "$_f"; then
            _skipped=$((_skipped+1))
            printf '  %sskip%s    %s (already has monitor block)\n' "${C_DIM:-}" "${C_R:-}" "$(basename "$_f")"
            continue
        fi
        if cp -p "$_f" "$_f.bak.$_ts" && append_tunables_block "$_f"; then
            _updated=$((_updated+1))
            printf '  %supdate%s  %s (backup: %s.bak.%s)\n' "${C_FLAG:-}" "${C_R:-}" "$(basename "$_f")" "$(basename "$_f")" "$_ts"
        else
            printf '  %sFAIL%s   %s (backup/append failed)\n' "${C_TITLE:-}" "${C_R:-}" "$(basename "$_f")"
        fi
    done
    printf '\n%supdated:%s %d   %sskipped:%s %d\n' "${C_CMD:-}" "${C_R:-}" "$_updated" "${C_DIM:-}" "${C_R:-}" "$_skipped"
    unset _updated _skipped _ts _f
    exit 0
fi

# --- MODO CREADOR: rdp-connect --new <perfil> ---
if [ "${1:-}" == "--new" ]; then
    NEW_PROFILE="${2:-}"
    [ -z "$NEW_PROFILE" ] && { echo "$MSG_NEW_USAGE"; exit 1; }

    TARGET_FILE="$PROFILES_DIR/${NEW_PROFILE}.env"
    [ -f "$TARGET_FILE" ] && { printf "$MSG_NEW_EXISTS\n" "$NEW_PROFILE"; exit 1; }

    cp "$HOME/.config/rdp/template.env" "$TARGET_FILE"
    chmod 600 "$TARGET_FILE"
    printf "$MSG_NEW_CREATED\n" "$TARGET_FILE"

    SYSTEM_EDITOR="${EDITOR:-${VISUAL}}"
    if [ -z "$SYSTEM_EDITOR" ]; then
        for ed in nvim vim nano vi micro; do
            if command -v "$ed" &>/dev/null; then
                SYSTEM_EDITOR="$ed"
                break
            fi
        done
    fi

    # Si se invoca desde GUI sin TTY, lanzar dentro de emulador de terminal
    if [ ! -t 0 ]; then
        TERM_EMU="${TERMINAL:-kitty}"
        $TERM_EMU -e "$SYSTEM_EDITOR" "$TARGET_FILE" &
    else
        "$SYSTEM_EDITOR" "$TARGET_FILE"
    fi
    exit 0
fi

# --- MODO SELECTOR (Wofi / Rofi) ---
PROFILE="${1:-}"
if [ -z "$PROFILE" ]; then
    # F6 launcher OR-check: wofi OR rofi must be present in selector mode.
    # This check is deferred to here (not in the startup preflight) because the
    # launcher is only needed when no profile argument is given — a direct
    # `rdp-connect <profile>` never invokes the selector.
    if ! command -v wofi &>/dev/null && ! command -v rofi &>/dev/null; then
        echo "missing required command: wofi or rofi (install one via your package manager)" >&2
        exit 127
    fi
    # Build menu items with Nerd Font icon + HOST + USER (hyprcaffeine style).
    MENU_ITEMS=()
    for _pf in "$PROFILES_DIR"/*.env; do
        [ -f "$_pf" ] || continue
        _pn=$(basename "$_pf" .env)
        _ph=$(grep -m1 '^HOST=' "$_pf" 2>/dev/null | cut -d= -f2- | sed 's/^"//; s/" *#.*//; s/"$//' || true)
        _pu=$(grep -m1 '^USER_RDP=' "$_pf" 2>/dev/null | cut -d= -f2- | sed 's/^"//; s/" *#.*//; s/"$//' || true)
        _line="󰍹 ${_pn}"
        [ -n "$_ph" ] && _line="${_line}    ${_ph}"
        [ -n "$_pu" ] && _line="${_line}    ${_pu}"
        MENU_ITEMS+=("$_line")
    done
    # Dynamic box height: ~45px per entry + 80px search/padding, min 200, cap 800.
    # IMPORTANT: walker says "DON'T USE SHORTHAND" for -h (conflicts with --help).
    # Must use --height (long form).
    _box_h=$(( (${#MENU_ITEMS[@]} * 45) + 80 ))
    [ "$_box_h" -lt 200 ] && _box_h=200
    [ "$_box_h" -gt 800 ] && _box_h=800
    _sel=""
    if command -v walker &>/dev/null; then
        _sel=$(printf '%s\n' "${MENU_ITEMS[@]}" | walker -d -N --placeholder="🖥 RDP Connect" --width=1050 --maxwidth=1050 --height="$_box_h" 2>/dev/null || true)
    elif command -v wofi &>/dev/null; then
        _sel=$(printf '%s\n' "${MENU_ITEMS[@]}" | wofi -d -p "🖥 RDP Connect" -W 1050 -H "$_box_h" --cache-file=/dev/null 2>/dev/null || true)
    elif command -v rofi &>/dev/null; then
        _sel=$(printf '%s\n' "${MENU_ITEMS[@]}" | rofi -dmenu -p "🖥 RDP Connect" -i -l "${#MENU_ITEMS[@]}" 2>/dev/null || true)
    fi
    # Extract profile name: strip the icon prefix, then first field before sep.
    _stripped="${_sel#* }"
    PROFILE="${_stripped%%    *}"
    unset _pf _pn _ph _pu _line _sel _stripped MENU_ITEMS
fi
[ -z "$PROFILE" ] && exit 0

ENV_FILE="$PROFILES_DIR/${PROFILE}.env"
[ ! -f "$ENV_FILE" ] && { notify-send -u critical "RDP Error" "$(printf "$MSG_ERR_NO_PROFILE" "$PROFILE")" 2>/dev/null || true; exit 1; }

# Pre-initialize all allowlisted profile keys to empty so set -u never aborts
# on an optional key the user omitted from their profile. HOST/USER_RDP/PASS_RDP
# remain effectively required — an empty value produces a clear xfreerdp3 error
# at connection time (better UX than a set -u "unbound variable" crash).
HOST="" USER_RDP="" PASS_RDP="" DOMAIN=""
VPN_CHECK="" PREFERRED_WS="" LANG_OVERRIDE=""

# Carga segura de variables — abort on parser failure (F3 security boundary).
# parse_env_safe prints 'parse_env_safe: <file>:<line>: <reason>' to stderr;
# the engine surfaces via notify-send (best-effort) and exits 1 so a malformed
# or hostile profile can NEVER reach xfreerdp3.
parse_env_safe "$ENV_FILE" profile || {
    notify-send -u critical "RDP Error" "Perfil '$PROFILE' inválido. Ver consola." 2>/dev/null || true
    exit 1
}

# T2.1: Trim leading/trailing whitespace from network-identifier fields so
# `VPN_CHECK=" "`, `VPN_CHECK="  10.8.0.1  "`, or `HOST="  server  "` (common
# copy-paste / editor mistakes) don't silently corrupt the TCP probes.
# PASS_RDP is intentionally NOT trimmed — passwords MAY legitimately contain
# leading/trailing spaces. USER_RDP also left untouched for the same reason.
#
# T2.6 (engine-security-delta R1): the trim allowlist (5 trimmed + 2 excluded)
# MUST live in exactly one place — lib/rdp-common.bash::trim_profile_fields —
# so drift between consumers is impossible. The inline parameter-expansion
# idiom was lifted verbatim into the lib fn; the engine now delegates so the
# bats suite tests the REAL trim, not a reimplementation.
trim_profile_fields

[ -n "${LANG_OVERRIDE:-}" ] && load_language "$LANG_OVERRIDE"

WM_CLASS="rdp-${PROFILE}"
LOG_FILE="$LOG_DIR/${PROFILE}.log"
# T1.4 (F5): uid-private PID path under XDG_RUNTIME_DIR (or /tmp fallback with
# uid suffix). Eliminates the world-writable /tmp/rdp-<profile>.pid symlink/DoS
# vector — two users on the same host can no longer collide or interfere.
PID_FILE="$(compute_pid_path "$PROFILE")"
START_TIME=$(date +%s)

# log_event lives in lib/rdp-common.bash (extracted for unit-testable verbose
# tee). It reads LOG_FILE + VERBOSE globals at call time; both are set by here.

# --- SINGLE INSTANCE GUARD (Flock exclusivo por perfil) ---
# flock is process-bound: a crashed peer's lock is released by the kernel,
# so our flock -n succeeds and we overwrite the stale PID content below
# (stale-lock reclamation is automatic). A live peer holds the fd → flock -n
# fails → we focus the existing window and exit 0 (peer-honored).
#
# _LOCK_ACQUIRED (multi-peer race fix from T1.4 discovery): only the lock owner
# unlinks the PID file in the EXIT trap. A peer that failed flock -n does NOT
# own the lock — unlinking the file would break the first instance's per-inode
# flock and allow a third instance to bypass it.
_LOCK_ACQUIRED=false
# Read the existing PID BEFORE truncating the file with exec 200> below.
# (exec 200> truncates; reading after would always get empty.)
# shellcheck disable=SC2188  # $(<file) is the bash no-fork file-read idiom
_peer=$(<"$PID_FILE" 2>/dev/null || true)
exec 200>"$PID_FILE"
if ! flock -n 200; then
    # An existing session for this profile is active. KILL it so we can relaunch
    # (the user wants replace, not focus-and-exit). The peer runs under setsid
    # (own session/group), so kill its process group to reap engine + xfreerdp3.
    if [ -n "$_peer" ] && kill -0 "$_peer" 2>/dev/null; then
        log_event "WARN" "Instancia activa pid=$_peer. Matando para relanzar..."
        notify-send -i display "RDP $PROFILE" "Cerrando sesión previa (pid=$_peer)..." || true
        kill -- "-$_peer" 2>/dev/null || kill "$_peer" 2>/dev/null || true
        sleep 1
        kill -0 "$_peer" 2>/dev/null && { kill -9 -- "-$_peer" 2>/dev/null || kill -9 "$_peer" 2>/dev/null || true; }
        sleep 0.5
    fi
    # Also kill any stray FreeRDP process matching this profile's WM_CLASS
    pkill -f "wm-class:$WM_CLASS" 2>/dev/null || true
    sleep 0.5
    # Try to reclaim the lock
    if flock -n 200; then
        log_event "INFO" "Lock reclamado. Relanzando sesión."
    else
        log_event "ERROR" "No se pudo adquirir el lock tras matar la instancia previa."
        notify-send -u critical "RDP Error" "No se pudo relanzar $PROFILE (lock atascado)." || true
        exit 1
    fi
fi
unset _peer
_LOCK_ACQUIRED=true
echo "$$" >&200

# --- CLEANUP TRAP & DIAGNÓSTICO ---
cleanup() {
    EXIT_CODE=$?
    # multi-peer-race (F-G fix part 2): reap the engine's process group BEFORE
    # any logging. Children (xfreerdp3) get killed first so they don't outlive
    # the engine. `kill -- -$$` sends to all processes in pgid == $$ (the
    # engine is the leader thanks to setpgid at startup). `--` guards against
    # $$ looking like a flag (e.g. SIGHUP if -1). `2>/dev/null || true` because
    # kill on already-dead processes returns non-zero.
    kill -- -$$ 2>/dev/null || true
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))

    if [ $EXIT_CODE -ne 0 ]; then
        # F9 / T2.5 (Bug B) context: scope the error search to the CURRENT
        # session only. The SESSION_START marker (pid=$$) written as the first
        # log line of this session bounds the scan — without it, a `tail -n N`
        # would surface stale ERROR lines from PREVIOUS sessions in the same
        # per-profile LOG_FILE as if they were this session's failure cause
        # (e.g. an old "VPN requerida inalcanzable" from days ago reported
        # as the cause of a fresh parse/preflight failure).
        #
        # The pid= suffix on the marker makes it unique to THIS process so
        # concurrent sessions on the same profile (impossible under flock but
        # defensive) cannot cross-pollinate. PID prefix safety (222 vs 2222)
        # is enforced inside the fn via the `([^0-9]|$)` awk anchor.
        #
        # T3.1: the file-existence guard + awk extractor were lifted verbatim
        # into lib/rdp-common.bash::extract_session_error (pure text
        # transformation, no side effects — safe to unit-test). The engine's
        # old `[ -n "${START_TIME:-}" ]` defensive guard is dropped: the trap
        # registers AFTER START_TIME is assigned (L192 → trap L272), so the
        # guard is statically true at every cleanup invocation. If no marker
        # for our PID exists (e.g. trap fired before the first log_event
        # call), the fn returns empty — the caller falls back to the generic
        # 'Ver log en $LOG_FILE' message, which is correct.
        LAST_ERROR="$(extract_session_error "$LOG_FILE" "$$")"
        log_event "ERROR" "Sesión finalizada con error (Código $EXIT_CODE). Duración: ${DURATION}s."
        log_event "ERROR" "Causa reportada: ${LAST_ERROR:-Error no especificado}"
        notify-send -u critical -i network-error "RDP $PROFILE Error" "${LAST_ERROR:-Ver log en $LOG_FILE}" || true
    else
        log_event "INFO" "Sesión finalizada correctamente. Duración total: ${DURATION}s."
        notify-send -i display-off "RDP $PROFILE" "$MSG_SESSION_ENDED" || true
    fi
    # multi-peer-race (F-G fix part 3): do NOT unlink $PID_FILE.
    # The previous code (baseline-hardening T1.4 + T2.2 _LOCK_ACQUIRED guard)
    # closed the ORIGINAL T1.4 race (peer-branch triggering cleanup), but
    # the exploration for this change found a DIFFERENT race (R7): when a
    # signal (SIGTERM, SIGINT) fires the EXIT trap while fd 200 still holds
    # the inode lock, unlinking the path leaves the inode anonymous but
    # locked. A third process opening $PID_FILE creates a NEW inode at the
    # same path; its flock -n succeeds on the new inode → two concurrent
    # xfreerdp3 sessions against the same profile. Reproduced empirically
    # in openspec/changes/multi-peer-race/explore.md.
    #
    # Fix: never unlink. Kernel releases flock on process death; the path
    # persists benignly in $XDG_RUNTIME_DIR; next start's `exec 200>` +
    # `flock -n` reclaims a stale lockfile automatically.
    #
    # Spec amendment: openspec/specs/instance-locking/spec.md will be
    # updated at /sdd-archive to invert the "EXIT trap MUST remove" rule.
    # The canonical amendment is deferred to archive per SDD convention.
    #
    # `_LOCK_ACQUIRED` is kept for diagnostic purposes (logging) but no
    # longer gates any file operation.
    :
}
trap cleanup EXIT

# T2.5 (Bug B): SESSION_START marker is the FIRST log line of this session.
# cleanup() uses it to scope its error diagnostic to the CURRENT session only
# — preventing stale ERROR lines from previous sessions (same per-profile
# LOG_FILE) from being reported as this session's failure cause. The pid=
# suffix makes the marker unique to this PID so concurrent sessions on the
# same profile (impossible under flock but defensive) can't cross-pollinate.
# This MUST be the first log_event call so any later failure (VPN check, host
# check, xfreerdp3) has a bounded "current session" window to scan.
log_event "SESSION_START" "pid=$$ profile=$PROFILE"
log_event "INFO" "=================== INICIO DE SESIÓN RDP ==================="
log_event "INFO" "Perfil: $PROFILE | Host: $HOST | Usuario: $USER_RDP"

# --- PRE-FLIGHT CHECK (Vía socket nativo /dev/tcp) ---
# T2.6: VPN_CHECK is trimmed right after parse_env_safe (line ~167), so "  " or
# "  host  " in the profile becomes "" or "host" respectively. The guard below
# then correctly treats empty (no VPN configured) as SKIP, and a real host as
# ENTER. Without the trim, "  " passed `-n` and produced "VPN requerida ( )
# inalcanzable" on every invocation.
if [ -n "${VPN_CHECK:-}" ]; then
    log_event "INFO" "Verificando VPN ($VPN_CHECK)..."
    if ! timeout 2 bash -c "</dev/tcp/$VPN_CHECK/3389" &>/dev/null; then
        ERR_VPN=$(printf "$MSG_ERR_VPN" "$VPN_CHECK")
        log_event "ERROR" "VPN requerida ($VPN_CHECK) inalcanzable. Abortando."
        notify-send -u critical -i network-vpn "RDP Error" "$ERR_VPN" || true
        exit 1
    fi
fi

log_event "INFO" "Verificando disponibilidad de puerto 3389 en $HOST..."
if ! timeout 2 bash -c "</dev/tcp/$HOST/3389" &>/dev/null; then
    ERR_HOST=$(printf "$MSG_ERR_HOST_UNREACHABLE" "$HOST")
    log_event "ERROR" "Servidor $HOST:3389 inalcanzable. Abortando."
    notify-send -u critical -i network-error "RDP Error" "$ERR_HOST" || true
    exit 1
fi
log_event "INFO" "Puerto 3389 en $HOST respondiendo correctamente."

# --- HIDPI AUTO-SCALING (F1: jq-native, no bc/python3) ---
# compute_dpi_flags lives in lib/rdp-common.bash. It sets DPI_FLAGS[] (array),
# IS_HIDPI, and SCALE_PCT via a single `hyprctl monitors -j | jq` call.
# Null / missing / non-numeric scale → WARN + 100% fallback (session proceeds).
compute_dpi_flags

# --- MULTI-MONITOR Y REGLAS DE HYPRLAND ---
# sort_by(.x): hyprctl's numeric monitor `id` is assigned by detection/
# connection order, NOT physical left-to-right position (confirmed on real
# hardware: DP-3 id=0 x=1920, DP-6 id=2 x=3840, DP-5 id=1 x=6400). This
# sorts the DEFAULT "all detected" list (MONITOR_ORDER/--monitor-order
# overrides bypass it, unchanged) so the WINDOW POSITIONING math (multi/span,
# which uses Hyprland's real coordinates via hyprctl) lands correctly — and
# it does (confirmed: window origin matched the real leftmost monitor).
#
# KNOWN UNVERIFIED GAP (multi mode only): this sort does NOT guarantee
# /multimon's PER-MONITOR CONTENT ends up on the right physical monitor.
# `xfreerdp3 /list:monitor` (queries XWayland, not Hyprland) reported these
# same 3 monitors at ITS OWN virtual x-offsets 0/1920/3840 — a totally
# different coordinate space than hyprctl's — and since two of them share
# the same 1920x1080 resolution, there is no way to tell from either tool's
# output alone which /monitors:<id> maps to which physical output; it can
# only be confirmed by watching the screen. span mode is NOT affected (it
# sends ONE /size:<canvas> desktop, never asks FreeRDP to split content per
# monitor id) — prefer --span over --multi-mon when this ambiguity matters.
_MON_IDS=$(hyprctl monitors -j | jq -r 'sort_by(.x) | .[].id' | paste -sd, -)
MON_COUNT=$(hyprctl monitors -j | jq '. | length')
# F8: MON_FLAGS is an array, not a string. build_mon_flags (in lib) sets
# MON_FLAGS=("/multimon" "/monitors:<ids>") or ("/f"). Expanded at the
# xfreerdp3 invocation site below as "${MON_FLAGS[@]}".
#
# DO NOT use "${arr[@]-}" here or for DPI_FLAGS. Bash gotcha: with a DECLARED-
# EMPTY array, "${arr[@]-}" yields a single empty-string token (argc=1), not
# zero tokens. DPI_FLAGS is empty when scale==1.0, so the old "${DPI_FLAGS[@]-}"
# form injected a phantom '' into argv that xfreerdp3 3.30.0 rejects as
# "Unsupported command line syntax". "${arr[@]}" (no `-`) is correct: bash 4.4+
# does not trip set -u on an empty array. See tests/freerdp3-flags.bats.
# --- MONITOR MODE (MONITOR_MODE profile key + --single-mon/--multi-mon CLI) ---
# Effective mode: CLI override wins, else profile MONITOR_MODE, else multi.
# Under Hyprland/XWayland, /multimon renders all remote monitors into one
# window (can't span physical outputs); single mode fullscreens one remote
# monitor. MON_FLAGS is an array; expanded with "${MON_FLAGS[@]}" (zero args
# when empty — the correct form, NO `-`).
# Pre-resolve effective client (full CLIENT SELECTION is at L533; this early
# read lets the monitor block skip /monitors: for SDL — it has its own IDs).
_eff_client="${_client_override:-${CLIENT:-x11}}"
MON_FLAGS=()
case "${MONITOR_MODE_OVERRIDE:-${MONITOR_MODE:-single}}" in
    single)
        _EFF_MODE=single
        # Always dynamic + floating: the remote desktop resolution follows the
        # client window size live (FreeRDP +dynamic-resolution, needs Win8.1+
        # server — the laptop Win11 supports it). No /size, no +f — fullscreen
        # on launch comes from the Hyprland hl.dsp.window.fullscreen dispatcher
        # below (WM-level), and the window is set floating (hl.dsp.window.float)
        # so leaving fullscreen always gives a freely draggable/resizable
        # window, cross-monitor, whose RDP resolution tracks the resize live.
        # DYNAMIC_RESOLUTION_OVERRIDE/MONITOR_ID/MONITOR_<id> are kept accepted
        # by parse_env_safe (existing profiles must not break) but are no
        # longer consulted here — dynamic+floating is unconditional now.
        MON_FLAGS=("+dynamic-resolution")
        log_event "INFO" "Modo single-monitor (+dynamic-resolution, floating, redimensionable entre monitores)."
        ;;
    span)
        # Unify N physical monitors into ONE floating window sized to their
        # combined canvas — the "triple monitor as one" case. Same monitor-
        # selection precedence as multi mode (reuses MONITOR_ORDER/MONITORS —
        # no new profile keys needed): --monitor-order flag > MONITOR_ORDER
        # config > first N of detected (--monitors / MONITORS) > all detected.
        #
        # Canvas math (auto-detected via hyprctl monitors -j, NOT hardcoded):
        # width = sum of the selected monitors' widths; height = the MAXIMUM
        # of their heights, so a taller monitor (e.g. a 1440p center between
        # two 1080p monitors) keeps its full native resolution instead of
        # being cropped to the shortest one. Trade-off: on a shorter monitor,
        # only the top <its height> rows of the shared canvas are physically
        # visible — there is no screen below that to show the rest. That's a
        # display-hardware limit, not a bug (see tests/span-mode.bats).
        # Origin = the top-left corner (min x, min y) among the selected
        # monitors, so xfreerdp3 is positioned to align with them regardless
        # of where they sit in the global Hyprland layout.
        _EFF_MODE=span
        _order="${MONITOR_ORDER_OVERRIDE:-${MONITOR_ORDER:-}}"
        if [ -n "$_order" ]; then
            _span_ids="$_order"
        elif [ -n "${MONITORS_OVERRIDE:-${MONITORS:-}}" ]; then
            _mn="${MONITORS_OVERRIDE:-${MONITORS:-}}"
            _span_ids=$(printf '%s\n' "$_MON_IDS" | tr ',' '\n' | head -n "$_mn" | paste -sd, -)
            unset _mn
        else
            _span_ids="$_MON_IDS"
        fi
        _span_json=$(hyprctl monitors -j 2>/dev/null | jq -c --arg ids "$_span_ids" \
            '($ids | split(",") | map(tonumber)) as $sel
             | [.[] | select(.id as $i | $sel | index($i) != null)]' 2>/dev/null || true)
        _span_w=$(printf '%s' "${_span_json:-[]}" | jq '[.[].width] | add // empty' 2>/dev/null || true)
        _span_h=$(printf '%s' "${_span_json:-[]}" | jq '[.[].height] | max // empty' 2>/dev/null || true)
        _SPAN_X=$(printf '%s' "${_span_json:-[]}" | jq '[.[].x] | min // 0' 2>/dev/null || echo 0)
        _SPAN_Y=$(printf '%s' "${_span_json:-[]}" | jq '[.[].y] | min // 0' 2>/dev/null || echo 0)
        if [ -n "${_span_w:-}" ] && [ -n "${_span_h:-}" ]; then
            MON_FLAGS=("/size:${_span_w}x${_span_h}")
            log_event "INFO" "Modo span: monitores [$_span_ids] -> canvas ${_span_w}x${_span_h} en (${_SPAN_X},${_SPAN_Y})."
        else
            log_event "WARN" "Modo span: no se pudo calcular el canvas (hyprctl/jq). Fallback a multi-monitor."
            build_mon_flags "$MON_COUNT" "$_MON_IDS"
            _EFF_MODE=multi
        fi
        unset _order _span_ids _span_json _span_w _span_h
        ;;
    multi|*)
        _EFF_MODE=multi
        if [ "${_eff_client:-x11}" = "sdl" ]; then
            # sdl-freerdp3 has its OWN monitor ID scheme (not hyprctl). Don't
            # pass /monitors: — let SDL auto-detect all monitors. Just /multimon.
            MON_FLAGS=("/multimon")
            _MULTI_IDS="$_MON_IDS"
            log_event "INFO" "Modo multi-monitor (SDL): /multimon (auto-detect)."
        else
        # Build /monitors list. Precedence: --monitor-order flag > MONITOR_ORDER
        # config > first N of detected (--monitors / MONITORS) > all detected.
        # NOTE: per-monitor resolution (MONITOR_<id>) is IGNORED in multi —
        # FreeRDP /multimon uses each monitor's native resolution.
        _order="${MONITOR_ORDER_OVERRIDE:-${MONITOR_ORDER:-}}"
        if [ -n "$_order" ]; then
            MON_FLAGS=("/multimon" "/monitors:$_order")
            _MULTI_IDS="$_order"
        elif [ -n "${MONITORS_OVERRIDE:-${MONITORS:-}}" ]; then
            _mn="${MONITORS_OVERRIDE:-${MONITORS:-}}"
            _first=$(printf '%s\n' "$_MON_IDS" | tr ',' '\n' | head -n "$_mn" | paste -sd, -)
            MON_FLAGS=("/multimon" "/monitors:$_first")
            _MULTI_IDS="$_first"
            unset _first _mn
        else
            build_mon_flags "$MON_COUNT" "$_MON_IDS"
            _MULTI_IDS="$_MON_IDS"
        fi
        log_event "INFO" "Modo multi-monitor: ${MON_FLAGS[*]}."
        unset _order
        fi
        # Position the /multimon window at its monitors' origin (min x, min
        # y) — without this, Hyprland tiles it wherever its default layout
        # puts it (the "cramped" window this project's README already warns
        # about), since to the compositor it's just a regular XWayland window
        # that happens to be big, not something that's supposed to span 3
        # specific physical outputs. FreeRDP negotiates the window's SIZE
        # itself from /monitors:<ids>, so only the origin is computed here —
        # no forced resize (unlike --expand's riskier absolute-resize call).
        _multi_json=$(hyprctl monitors -j 2>/dev/null | jq -c --arg ids "$_MULTI_IDS" \
            '($ids | split(",") | map(tonumber)) as $sel
             | [.[] | select(.id as $i | $sel | index($i) != null)]' 2>/dev/null || true)
        _MULTI_X=$(printf '%s' "${_multi_json:-[]}" | jq '[.[].x] | min // 0' 2>/dev/null || echo 0)
        _MULTI_Y=$(printf '%s' "${_multi_json:-[]}" | jq '[.[].y] | min // 0' 2>/dev/null || echo 0)
        unset _multi_json
        ;;
esac

# --- AUDIO TOGGLE (AUDIO_REDIRECT profile key + --no-audio CLI override) ---
# Three modes, matching mstsc "Remote Audio Playback":
#   AUDIO_REDIRECT=1 (default) -> /sound + /microphone  ("Play on this computer" = redirect to client)
#   AUDIO_REDIRECT=0           -> /audio-mode:1         ("Play on remote computer" = server's local speakers)
#   --no-audio (CLI override)  -> (empty)               ("Do not play" = no audio at all)
#
# WARNING: xfreerdp3 /? MISLABELS /audio-mode. The help claims :2 is "server",
# but the source (settings.h) + empirical RDP-flag verification prove the real
# mapping: :0=redirect, :1=leave-on-server, :2=DISABLE. /audio-mode:1 sets
# INFO_REMOTECONSOLEAUDIO in the Client Info Packet (the "play on remote
# console" signal); /audio-mode:2 does NOT (it disables audio). Use :1 for
# server playback. See tests/audio-toggle.bats for the regression.
#
# Built as an array, expanded with "${SOUND_FLAGS[@]}" (zero args when empty —
# the CORRECT empty-array form; the "-default" gotcha that broke DPI_FLAGS
# must NOT come back here).
SOUND_FLAGS=()
if [ "${NO_AUDIO:-0}" = "1" ]; then
    : # --no-audio: no audio at all
elif [ "${AUDIO_REDIRECT:-1}" = "1" ]; then
    SOUND_FLAGS=("/sound:sys:pulse,latency:20" "/microphone:sys:pulse")
else
    # AUDIO_REDIRECT=0: play on the REMOTE server (xfreerdp3 /audio-mode:1 =
    # mstsc "Play on remote computer"; sets INFO_REMOTECONSOLEAUDIO). NOT empty
    # — empty produced the "no audio devices" bug (RDP session had no audio).
    SOUND_FLAGS=("/audio-mode:1")
fi

# --- CLIENT SELECTION (x11 [default] | sdl | wayland) ---
# Selects the FreeRDP binary + client-specific env + extra flags.
#   x11     -> xfreerdp3    (XWayland; best for single-mon)
#   sdl     -> sdl-freerdp3 (SDL3; multimon 3-ventanas con wlroots hack + grab flags)
#   wayland -> wlfreerdp3   (native Wayland; single-mon only — no multimon)
_eff_client="${_client_override:-${CLIENT:-x11}}"
CLIENT_FLAGS=()
case "$_eff_client" in
    sdl)
        _RDP_CLIENT=sdl-freerdp3
        export FREERDP_WLROOTS_HACK=force
        export SDL_VIDEODRIVER=wayland
        CLIENT_FLAGS=("+grab-keyboard" "/mouse-motion" "/bpp:16")
        _gfx_flag=""   # no /gfx for SDL — bitmap rendering (lighter than H.264)
        log_event "INFO" "Cliente SDL (sdl-freerdp3). Multimon + sin gfx (bitmap)."
        ;;
    wayland|wl)
        _RDP_CLIENT=wlfreerdp3
        log_event "INFO" "Cliente Wayland nativo (wlfreerdp3). Single-mon."
        ;;
    x11|*)
        _RDP_CLIENT=xfreerdp3
        _gfx_flag="/gfx:avc444"
        ;;
esac

# --- BACKGROUND WINDOW MANAGEMENT (Hyprland 0.55+ Lua dispatcher API) ---
# The new API is action-based (the window must already exist), but xfreerdp3
# hasn't created it yet. Spawn a background subshell that polls for the window
# by class, then: moves it to PREFERRED_WS, focuses it, and (single mode)
# fullscreens it. Runs concurrently with the xfreerdp3 pipeline below.
# `hyprctl dispatch '<lua>'` executes the dispatcher; `class:$WM_CLASS` is the
# selector. See tests/hyprland-api.bats + wiki/Using-hyprctl.
(
    # Close the lock fd so this background subshell does NOT independently hold
    # the flock — only the main engine process holds it. Otherwise the lock
    # would persist as long as this helper (or any other child) is alive, even
    # after the engine exits (the lock-leak root cause).
    exec 200>&-
    _tries=0
    while [ "$_tries" -lt 30 ]; do
        if hyprctl clients -j 2>/dev/null | jq -e --arg c "$WM_CLASS" 'any(.[]; .class==$c)' >/dev/null 2>&1; then
            break
        fi
        sleep 0.2
        _tries=$((_tries+1))
    done
    if [ -n "${PREFERRED_WS:-}" ]; then
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"$PREFERRED_WS\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        log_event "INFO" "Ventana $WM_CLASS movida al Workspace $PREFERRED_WS." 2>/dev/null || true
    fi
    hyprctl dispatch "hl.dsp.focus({ window = \"class:$WM_CLASS\" })" &>/dev/null || true
    if [ "${_EFF_MODE:-multi}" = "single" ]; then
        # Float BEFORE fullscreen: fullscreen works on tiled windows too, but
        # only a floating window keeps a free-form geometry to fall back to
        # when the user later un-fullscreens (Hyprland fullscreen keybind) —
        # that's what makes the window draggable/resizable across monitors.
        hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        log_event "INFO" "Ventana $WM_CLASS floating (drag/resize entre monitores)." 2>/dev/null || true
        hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"set\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        log_event "INFO" "Ventana $WM_CLASS fullscreen (single-mon)." 2>/dev/null || true
    elif [ "${_EFF_MODE:-multi}" = "span" ]; then
        # Position the /size:-matched window at the spanned monitors' origin,
        # floating (so it can still be dragged), and drop border/blur/shadow —
        # this window covers a multi-monitor canvas and any compositor effect
        # on it is wasted GPU work on modest hardware (see explore notes on
        # i3 6th-gen + 8GB perf). Other windows are untouched (set_prop is
        # scoped to class:$WM_CLASS, unique per profile).
        hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.move({ x = ${_SPAN_X:-0}, y = ${_SPAN_Y:-0}, window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noborder\", value = \"true\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noblur\", value = \"true\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noshadow\", value = \"true\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        log_event "INFO" "Ventana $WM_CLASS spanning: floating en (${_SPAN_X:-0},${_SPAN_Y:-0}), sin borde/blur/sombra." 2>/dev/null || true
    elif [ "${_EFF_MODE:-multi}" = "multi" ]; then
        # /multimon already negotiates the correct WINDOW SIZE from the
        # /monitors:<ids> it was given — no resize dispatch needed here, just
        # float it (so it's not confined to Hyprland's tiling layout) and
        # move it to the selected monitors' origin so it actually lands ON
        # those physical outputs, instead of wherever the tiling layout put
        # it (the "cramped" window this project's README documents).
        hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.move({ x = ${_MULTI_X:-0}, y = ${_MULTI_Y:-0}, window = \"class:$WM_CLASS\" })" &>/dev/null || true
        hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"noborder\", value = \"true\", window = \"class:$WM_CLASS\" })" &>/dev/null || true
        log_event "INFO" "Ventana $WM_CLASS multi-monitor: floating y posicionada en (${_MULTI_X:-0},${_MULTI_Y:-0})." 2>/dev/null || true
    fi
) &

export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export LIBVA_DRIVER_NAME=iHD

notify-send -i display "RDP Framework" "$(printf "$MSG_CONNECTING" "$PROFILE" "$MON_COUNT")" || true

log_event "INFO" "Lanzando xfreerdp3 mediante STDIN seguro..."

# --- EJECUCIÓN (Contraseña oculta de la tabla de procesos ps aux) ---
# xfreerdp3 runs inside a subshell that CLOSES fd 200 (the lock fd), so
# xfreerdp3 and any process it spawns do NOT inherit the flock. Only the main
# engine process holds the lock → it releases the instant the engine exits.
# Output goes to a timestamping logger via process substitution (> >(...)).
# Unlike a pipeline (`xfreerdp3 | while`), the engine here waits for the
# { ... } group (i.e. xfreerdp3 itself) to finish — NOT for the pipe to reach
# EOF — so the engine exits as soon as xfreerdp3 dies, even if orphaned child
# processes momentarily hold the output pipe open (the lock-leak root cause).
echo "$PASS_RDP" | { exec 200>&-; ${_RDP_CLIENT} \
  /v:"$HOST" \
  ${DOMAIN:+/d:"$DOMAIN"} \
  /u:"$USER_RDP" \
  /from-stdin:force \
  /wm-class:"$WM_CLASS" \
  /sec:nla \
  /cert:tofu \
  "${MON_FLAGS[@]}" \
  "${DPI_FLAGS[@]}" \
  +grab-keyboard \
  /async-update \
  /mouse-motion \
  "${SOUND_FLAGS[@]}" \
  "${CLIENT_FLAGS[@]}" \
  +clipboard \
  +smartcard \
  +printer \
  /drive:compartido,"$SHARE_DIR" \
  /network:auto \
  ${_gfx_flag} \
  +fonts \
  +aero \
  +auto-reconnect \
  /auto-reconnect-max-retries:10; } > >(while IFS= read -r _rdp_line; do
    _rdp_ts="[$(date '+%Y-%m-%d %H:%M:%S')] [RDP] $_rdp_line"
    printf '%s\n' "$_rdp_ts" >> "$LOG_FILE"
    if [ "${VERBOSE:-0}" = "1" ]; then
        printf '%s\n' "$_rdp_ts" >&2
    fi
done) 2>&1
